datasets/_qa/
datasets/*/rgb/
datasets/*/gt/
datasets/*/gt_edge/
datasets/manifest.json
!datasets/README.md

# Model weights are large binaries; publish them as release assets.
model/*.pth
model/*.pt
model/*.onnx

# Training artifacts
runs/
reports/
*.log

